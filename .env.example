# Copiar a .env y completar. NUNCA subir .env al repositorio.

# --- SQL Server ---
# Autenticación de Windows (recomendado en local):
DB_SERVER=MILI\SQLEXPRESS
DB_NAME=CasinoPalacioReal
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_TRUSTED_CONNECTION=yes
# Autenticación SQL (dejar en blanco si se usa Windows auth):
DB_USER=
DB_PASSWORD=

# --- IA generativa (bloque 2 y 3) ---
# API de Anthropic para la capa de explicación y el chatbot RAG.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5

# --- Parámetros de negocio de la asignación de recompensas ---
PRESUPUESTO_CAMPANA=15000
COSTO_RECOMPENSA_ALTA=40
COSTO_RECOMPENSA_MEDIA=15
COSTO_RECOMPENSA_BAJA=5

# --- Telegram (notificación de la oferta + captura de la respuesta) ---
# Token del bot (@BotFather). Sin esto, telegram_bot.py corre en modo
# "dry-run": arma el mensaje y lo loguea, no llama a la API real.
TELEGRAM_BOT_TOKEN=
# Secreto para validar que el webhook lo llama Telegram y no un tercero.
TELEGRAM_WEBHOOK_SECRET=
